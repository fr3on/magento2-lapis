<script>
    // 1. Immediate Global Setup for Helpers & State
    window.lapisManager = {
        ready: false,
        vizes: {},
        focusedNodeId: null,
        data: <?= json_encode($allData) ?>
    };

    window.switchResource = function(id) {
        document.querySelectorAll('.resource-panel').forEach(p => p.style.display = 'none');
        const target = document.getElementById('lapis-resource-' + id);
        if (target) target.style.display = 'flex';
    };

    window.switchTab = function(type) {
        const panel = document.querySelector('.resource-panel[style*="display: flex"]');
        if (!panel) return;
        panel.querySelectorAll('.tab-content').forEach(c => c.style.display = 'none');
        const content = panel.querySelector('.' + type + '-tab');
        if (content) content.style.display = (type === 'visual' ? 'flex' : 'block');
        document.querySelectorAll('.tab-pill').forEach(b => b.classList.remove('active'));
        if (window.event && window.event.target) window.event.target.classList.add('active');
    };

    window.resetZoom = function(id) {
        if (!window.lapisManager.ready) return;
        const viz = window.lapisManager.vizes[id];
        if (viz) {
            viz.svg.transition().duration(750).call(viz.zoom.transform, window.d3.zoomIdentity);
        }
    };

    window.highlightTransition = function(resourceId, linkId) {
        if (!window.lapisManager.ready) return;
        window.d3.selectAll(`#svg-${resourceId} .link-${linkId}`).classed("highlighted", true);
    };

    window.clearHighlights = function(resourceId) {
        if (!window.lapisManager.ready) return;
        window.d3.selectAll(`#svg-${resourceId} .link`).classed("highlighted", false);
    };

    window.toggleFocus = function(resourceId, nodeId) {
        if (!window.lapisManager.ready) return;
        const d3 = window.d3;
        const svg = d3.select("#svg-" + resourceId);
        if (window.lapisManager.focusedNodeId === nodeId) {
            svg.selectAll(".node, .link").classed("focus-dim", false).classed("focus-active", false);
            window.lapisManager.focusedNodeId = null;
        } else {
            svg.selectAll(".node, .link").classed("focus-dim", true).classed("focus-active", false);
            svg.selectAll(".node").filter(d => d.id === nodeId).classed("focus-active", true).classed("focus-dim", false);
            svg.selectAll(".link").filter(d => d.source.id === nodeId || d.target.id === nodeId)
                .classed("focus-active", true).classed("focus-dim", false)
                .each(function(d) {
                    svg.selectAll(".node").filter(n => n.id === d.source.id || n.id === d.target.id)
                        .classed("focus-active", true).classed("focus-dim", false);
                });
            window.lapisManager.focusedNodeId = nodeId;
        }
    };

    // 2. Asynchronous Graph Engine
    require(['d3', 'domReady!'], function (d3) {
        window.d3 = d3;
        
        function initLapisVisualizer() {
            Object.keys(window.lapisManager.data).forEach(id => {
                const data = window.lapisManager.data[id];
                const svg = d3.select("#svg-" + id);
                const wrapper = document.getElementById("wrapper-" + id);
                if (!wrapper || !svg.node()) return;

                const width = wrapper.clientWidth || 800;
                const height = wrapper.clientHeight || 500;
                svg.attr("width", "100%").attr("height", "100%").attr("viewBox", `0 0 ${width} ${height}`);

                const container = svg.append("g");
                const zoom = d3.zoom().on("zoom", (e) => container.attr("transform", e.transform));
                svg.call(zoom);
                window.lapisManager.vizes[id] = { svg, container, zoom, width, height };

                const nodes = data.states.map(s => ({ ...s, id: s.id }));
                const nodeIds = new Set(nodes.map(n => n.id));
                
                // Safe Link Mapping: Skip transitions pointing to missing nodes
                const links = data.transitions
                    .filter(t => nodeIds.has(t.from) && nodeIds.has(t.to))
                    .map(t => ({ source: t.from, target: t.to, id: `${t.from}-${t.to}`, label: t.via }));

                const simulation = d3.forceSimulation(nodes)
                    .force("link", d3.forceLink(links).id(d => d.id).distance(140))
                    .force("charge", d3.forceManyBody().strength(-400))
                    .force("center", d3.forceCenter(width / 2, height / 2))
                    .force("collision", d3.forceCollide().radius(50));

                svg.append("defs").append("marker")
                    .attr("id", "arrow-" + id).attr("viewBox", "0 -5 10 10")
                    .attr("refX", 25).attr("refY", 0).attr("markerWidth", 5).attr("markerHeight", 5)
                    .attr("orient", "auto").append("path").attr("d", "M0,-5L10,0L0,5").attr("fill", "#d1d5da");

                const linkG = container.append("g").selectAll("path").data(links).enter().append("path")
                    .attr("class", d => `link link-${d.id}`).attr("marker-end", `url(#arrow-${id})`);

                const nodeG = container.append("g").selectAll("g").data(nodes).enter().append("g")
                    .attr("class", d => `node ${d.initial ? 'initial' : ''} ${d.terminal ? 'terminal' : ''}`)
                    .on("click", (e, d) => window.toggleFocus(id, d.id))
                    .call(d3.drag()
                        .on("start", (e) => { if (!e.active) simulation.alphaTarget(0.3).restart(); e.subject.fx = e.x; e.subject.fy = e.y; })
                        .on("drag", (e) => { e.subject.fx = e.x; e.subject.fy = e.y; })
                        .on("end", (e) => { if (!e.active) simulation.alphaTarget(0); e.subject.fx = null; e.subject.fy = null; }));

                nodeG.append("circle").attr("r", 15);
                nodeG.append("text").text(d => d.label).attr("dy", 35).attr("text-anchor", "middle");

                simulation.on("tick", () => {
                    linkG.attr("d", d => {
                        const dx = d.target.x - d.source.x, dy = d.target.y - d.source.y, dr = Math.sqrt(dx * dx + dy * dy) * 1.5;
                        return `M${d.source.x},${d.source.y}A${dr},${dr} 0 0,1 ${d.target.x},${d.target.y}`;
                    });
                    nodeG.attr("transform", d => `translate(${d.x},${d.y})`);
                });
            });
            window.lapisManager.ready = true;
        }

        initLapisVisualizer();
    });
</script>
