<script>
    const lapisData = <?= json_encode($allData) ?>;
    const vizes = {};

    function initVizes() {
        Object.keys(lapisData).forEach(id => {
            const data = lapisData[id];
            const svg = d3.select("#svg-" + id);
            const wrapper = document.getElementById("wrapper-" + id);
            const width = wrapper.clientWidth;
            const height = wrapper.clientHeight;

            svg.attr("width", "100%").attr("height", "100%")
               .attr("viewBox", `0 0 ${width} ${height}`);

            const container = svg.append("g");
            const zoom = d3.zoom().on("zoom", (e) => container.attr("transform", e.transform));
            svg.call(zoom);
            
            vizes[id] = { svg, container, zoom, width, height };

            const nodes = data.states.map(s => ({ ...s, id: s.id }));
            const links = data.transitions.map(t => ({ 
                source: t.from, 
                target: t.to, 
                label: t.via,
                id: `${t.from}-${t.to}`
            }));

            const simulation = d3.forceSimulation(nodes)
                .force("link", d3.forceLink(links).id(d => d.id).distance(150))
                .force("charge", d3.forceManyBody().strength(-500))
                .force("center", d3.forceCenter(width / 2, height / 2))
                .force("collision", d3.forceCollide().radius(60));

            // Define Arrowheads
            svg.append("defs").append("marker")
                .attr("id", "arrow-" + id)
                .attr("viewBox", "0 -5 10 10")
                .attr("refX", 25)
                .attr("refY", 0)
                .attr("markerWidth", 6)
                .attr("markerHeight", 6)
                .attr("orient", "auto")
                .append("path")
                .attr("d", "M0,-5L10,0L0,5")
                .attr("fill", "rgba(255,255,255,0.4)");

            const linkG = container.append("g").attr("class", "links-layer")
                .selectAll("path")
                .data(links)
                .enter().append("path")
                .attr("class", d => `link link-${d.id}`)
                .attr("marker-end", `url(#arrow-${id})`);

            // Particle animation
            const particles = container.append("g").attr("class", "particles-layer")
                .selectAll("circle")
                .data(links)
                .enter().append("circle")
                .attr("class", "particle")
                .attr("r", 2);

            const nodeG = container.append("g").attr("class", "nodes-layer")
                .selectAll("g")
                .data(nodes)
                .enter().append("g")
                .attr("class", d => `node ${d.initial ? 'initial' : ''} ${d.terminal ? 'terminal' : ''}`)
                .call(d3.drag()
                    .on("start", dragstarted)
                    .on("drag", dragged)
                    .on("end", dragended));

            nodeG.append("circle").attr("r", 15);
            nodeG.append("text").text(d => d.label).attr("dy", 30).attr("text-anchor", "middle");

            simulation.on("tick", () => {
                linkG.attr("d", d => {
                    const dx = d.target.x - d.source.x,
                          dy = d.target.y - d.source.y,
                          dr = Math.sqrt(dx * dx + dy * dy) * 1.5;
                    return `M${d.source.x},${d.source.y}A${dr},${dr} 0 0,1 ${d.target.x},${d.target.y}`;
                });

                nodeG.attr("transform", d => `translate(${d.x},${d.y})`);
                
                // Move particles along paths
                particles.attr("cx", d => {
                    const path = linkG.filter(l => l === d).node();
                    if (path) {
                        const t = (Date.now() % 3000) / 3000;
                        return path.getPointAtLength(path.getTotalLength() * t).x;
                    }
                }).attr("cy", d => {
                    const path = linkG.filter(l => l === d).node();
                    if (path) {
                        const t = (Date.now() % 3000) / 3000;
                        return path.getPointAtLength(path.getTotalLength() * t).y;
                    }
                });
            });

            function dragstarted(event) {
                if (!event.active) simulation.alphaTarget(0.3).restart();
                event.subject.fx = event.subject.x;
                event.subject.fy = event.subject.y;
            }
            function dragged(event) {
                event.subject.fx = event.x;
                event.subject.fy = event.y;
            }
            function dragended(event) {
                if (!event.active) simulation.alphaTarget(0);
                event.subject.fx = null;
                event.subject.fy = null;
            }
        });
    }

    function switchResource(id) {
        document.querySelectorAll('.resource-panel').forEach(p => p.style.display = 'none');
        document.getElementById('lapis-resource-' + id).style.display = 'flex';
    }

    function switchTab(type) {
        const panel = document.querySelector('.resource-panel[style*="display: flex"]');
        panel.querySelectorAll('.tab-content').forEach(c => c.style.display = 'none');
        panel.querySelector('.' + type + '-tab').style.display = (type === 'visual' ? 'flex' : 'block');
        
        document.querySelectorAll('.pill').forEach(b => b.classList.remove('active'));
        event.target.classList.add('active');
    }

    function resetZoom(id) {
        const viz = vizes[id];
        viz.svg.transition().duration(750).call(viz.zoom.transform, d3.zoomIdentity);
    }

    function highlightTransition(resourceId, linkId) {
        d3.selectAll(`#svg-${resourceId} .link-${linkId}`).classed("highlighted", true);
    }

    function clearHighlights(resourceId) {
        d3.selectAll(`#svg-${resourceId} .link`).classed("highlighted", false);
    }

    // Start with a slight delay to ensure widths are calculated
    window.onload = () => setTimeout(initVizes, 100);
</script>
