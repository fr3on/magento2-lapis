    .link { stroke: #999; stroke-width: 2; marker-end: url(#arrowhead); }
    .link:hover { stroke: #007bdb; stroke-width: 4; }
</style>

<script>
    const lapisData = <?= json_encode($allData) ?>;

    function switchResource(id) {
        document.querySelectorAll('.resource-panel').forEach(p => p.style.display = 'none');
        document.getElementById('lapis-resource-' + id).style.display = 'block';
        renderGraph(id);
    }

    function switchTab(type) {
        const panel = document.querySelector('.resource-panel[style*="display: block"]');
        panel.querySelectorAll('.tab-content').forEach(c => c.style.display = 'none');
        panel.querySelector('.' + type + '-tab').style.display = 'block';
        
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        event.target.classList.add('active');
        
        if (type === 'visual') {
            const select = document.getElementById('lapis-resource-select');
            renderGraph(select.value);
        }
    }

    function renderGraph(resourceId) {
        const data = lapisData[resourceId];
        const svg = document.getElementById('svg-' + resourceId);
        const nodesG = svg.querySelector('.nodes');
        const linksG = svg.querySelector('.links');
        
        nodesG.innerHTML = '';
        linksG.innerHTML = '';

        // Add arrowhead marker
        if (!svg.querySelector('#arrowhead')) {
            const defs = document.createElementNS("http://www.w3.org/2000/svg", "defs");
            defs.innerHTML = `<marker id="arrowhead" markerWidth="10" markerHeight="7" refX="22" refY="3.5" orient="auto">
                <polygon points="0 0, 10 3.5, 0 7" fill="#999" />
            </marker>`;
            svg.appendChild(defs);
        }

        const states = data.states;
        const transitions = data.transitions;
        
        // Circular layout for nodes
        const centerX = 400;
        const centerY = 200;
        const radius = 150;
        const nodePositions = {};

        states.forEach((s, i) => {
            const angle = (i / states.length) * 2 * Math.PI;
            const x = centerX + radius * Math.cos(angle);
            const y = centerY + radius * Math.sin(angle);
            nodePositions[s.id] = {x, y};

            const g = document.createElementNS("http://www.w3.org/2000/svg", "g");
            g.setAttribute('class', 'node' + (s.initial ? ' initial' : '') + (s.terminal ? ' terminal' : ''));
            g.innerHTML = `
                <circle cx="${x}" cy="${y}" r="20" />
                <text x="${x}" y="${y+35}" text-anchor="middle" font-size="12" font-weight="bold">${s.label}</text>
            `;
            nodesG.appendChild(g);
        });

        transitions.forEach(t => {
            const start = nodePositions[t.from];
            const end = nodePositions[t.to];
            if (start && end) {
                const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
                line.setAttribute('x1', start.x);
                line.setAttribute('y1', start.y);
                line.setAttribute('x2', end.x);
                line.setAttribute('y2', end.y);
                line.setAttribute('class', 'link');
                linksG.appendChild(line);
            }
        });
    }

    function copySpec(id) {
        const text = document.getElementById(id).innerText;
        navigator.clipboard.writeText(text).then(() => {
            alert('YAML copied to clipboard');
        });
    }

    // Initial render
    window.onload = () => {
        const initialId = document.getElementById('lapis-resource-select').value;
        renderGraph(initialId);
    };
</script>
